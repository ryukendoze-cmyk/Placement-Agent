DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ps06
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/ps06_test
EMBEDDER=local            # local | hashing
EMBEDDING_DIM=384
LLM_PROVIDER=mock         # mock | bedrock | openai
LLM_MODEL=amazon.nova-lite-v1:0
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OPENAI_API_KEY=sk-air-...
OPENAI_MODEL=mistral/mistral-nemo
# OPENAI_BASE_URL=https://api.airouter.in/v1
LLM_TIMEOUT=90.0
AUTH_MODE=demo            # demo | strict
DEMO_ROLE_SWITCH=true
# SESSION_SECRET_KEY=change-me-to-a-long-random-secret-before-strict-mode
SESSION_TTL_SECONDS=604800
RATE_LIMIT_ENABLED=false
# TRUSTED_PROXIES=[]
TASK_BACKEND=memory       # memory | redis
# REDIS_URL=redis://127.0.0.1:6379/0
HF_HUB_OFFLINE=0
