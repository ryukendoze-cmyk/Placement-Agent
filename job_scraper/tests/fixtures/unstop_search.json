 {
  "id": 1785946,
  "public_url": "jobs/ai-python-instructor-neuronetwrks-ai-ed-pvt-ltd-1785946",
  "title": "AI & Python Instructor",
  "organization_id": 2097010,
  "type": "jobs",
  "subtype": "jobs",
  "regn_open": 1,
  "updated_at": "2026-11-01T21:59:04+05:30",
  "region": "online",
  "visibility": "public",
  "details": "<p><strong>About Us:</strong></p>\n<p>NeuroNetworks AI Ed is an Indian AI and technology education company. Our flagship Neuromind AI Creator Program is a 1-year, 104-lecture course for students after Class 10 and college tech students. Every student watches the same recorded lectures; hands-on practicals run in our own browser-based lab.</p>\n<p><strong>The Role:</strong></p>\n<p>You will be the instructor students see and hear in every lecture. You will write the lecture scripts and record ~40-minute lectures (concept explanations + live coding) for the whole program, from a detailed syllabus set by our Course Architect.</p>\n<p><strong>Topics:</strong></p>\n<p>AI foundations; Python (data structures, OOP, Pydantic, HTTP, exceptions, files); Git and AI coding tools; prompting and LLM APIs; React, FastAPI, PostgreSQL basics; Linux and Docker; local models and RAG; MCP; workflow automation; AI agents (LangChain, LangGraph, CrewAI, Claude Agent SDK); monitoring; AI security and governance.</p>\n<p><strong>Must Have:</strong></p>\n<ul data-spread=\"false\">\n<li>Minimum 3 years teaching through pre-recorded video lectures (Udemy, YouTube, edtech or corporate training).</li>\n<li>Fluent spoken and written English.</li>\n<li>Strong hands-on Python.</li>\n<li>Working knowledge of Generative AI (LLM APIs, prompting, RAG, agents).</li>\n<li>You write your own lecture scripts.</li>\n<li>Full-time from our Pune office.</li>\n<li>Able to join within 14 days of an offer.</li>\n</ul>\n<p><strong>Good to Have:</strong></p>\n<ul data-spread=\"false\">\n<li>React/FastAPI/PostgreSQL projects.</li>\n<li>Linux, Docker, Git.</li>\n<li>MCP or agent frameworks.</li>\n<li>PCEP or AWS Certified AI Practitioner.</li>\n<li>Experience teaching beginners.</li>\n<li>Ability to make simple slides.</li>\n</ul>",
  "short_id": "vDGhacd",
  "logoUrl2": "https://d8it4huxumps7.cloudfront.net/uploads/images/150x150/6ae4da666039d_organisation_image-RgmqeRD2mH36251386Eie7cGcPuW.png",
